# PostgreSQL connection string (Neon / Supabase / Railway / Vercel Postgres / local)
DATABASE_URL=postgres://user:password@host:5432/ai_daily
# ตั้งเป็น "require" เมื่อใช้ hosted DB ที่บังคับ SSL (Neon/Supabase ส่วนใหญ่ใส่ ?sslmode=require ใน URL ได้เลย)
# PGSSL=require

# --- เข้าสู่ระบบด้วย Google / GitHub (ไม่บังคับ — ไม่ตั้งก็ไม่แสดงปุ่ม) ---
# Redirect URI ที่ต้องลงทะเบียนกับ provider:
#   http://localhost:3000/api/auth/oauth/<google|github>/callback
#   https://<โดเมน-vercel>/api/auth/oauth/<google|github>/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# URL หลักของแอป ใช้สร้าง redirect URI (ไม่ตั้งก็ใช้ origin ของ request) เช่น https://ai-daily.vercel.app
# APP_URL=
