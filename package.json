{
  "name": "ai-daily",
  "version": "2.0.0",
  "private": true,
  "description": "Monitor weekly AI token usage and get a daily budget",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/migrate.mjs --optional && next build",
    "start": "next start",
    "db:migrate": "node scripts/migrate.mjs",
    "typecheck": "tsc --noEmit",
    "test": "TZ=Asia/Bangkok vitest run"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "arctic": "^3.7.0",
    "next": "^16.4.3",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
